PORT=5000
FRONTEND_ORIGIN=http://localhost:5173

# XAMPP MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=trieuminh

# Đặt giá trị riêng, đủ dài. Không commit backend/.env.
AUTH_SECRET=replace_with_your_own_random_secret_at_least_32_chars
# Chỉ tạo admin đầu tiên nếu chưa có admin hoạt động với tên đăng nhập.
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=replace_with_your_own_password_at_least_12_chars

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
UPLOAD_TOKEN=replace_with_a_long_random_secret

# AI chat: key chỉ nằm ở backend, tuyệt đối không đặt VITE_OPENAI_API_KEY
AI_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
# OPENAI_PROJECT_ID chỉ điền project id dạng proj_... nếu tài khoản yêu cầu; tracking id key_* không dùng để xác thực.
OPENAI_PROJECT_ID=
AI_TIMEOUT_MS=12000
CHAT_MAX_MESSAGE_LENGTH=4000
CHAT_RETENTION_DAYS=30

# Địa giới hành chính Việt Nam (backend proxy)
LOCATION_API_BASE_URL=https://provinces.open-api.vn/api
LOCATION_API_V2_BASE_URL=https://provinces.open-api.vn/api/v2

# QR chuyển khoản: để false nếu chưa có thông tin ngân hàng
PAYMENT_QR_ENABLED=false
PAYMENT_QR_BANK_ID=
PAYMENT_QR_ACCOUNT_NO=
PAYMENT_QR_ACCOUNT_NAME=
PAYMENT_QR_TEMPLATE=compact2
